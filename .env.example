# Режим: dev | release
APP_ENV=dev
LOG_LEVEL=INFO

# VK: peer_id чатов через запятую (1 в dev, 2 в release)
# Узнать peer_id можно из логов после первого запуска или из URL чата
VK_PEER_IDS=2000000001

# Путь к сохранённым credentials (создаётся bootstrap'ом)
VK_CREDENTIALS_PATH=./data/vk_creds.json

# Bootstrap (Chromium) — скрипт сам найдёт CDP или запустит Chromium
CDP_URL=http://127.0.0.1:9222
VK_PROFILE_DIR=./vk-profile
# VK2TG_HEADLESS=true   # если нет дисплея (нужен Xvfb)

# Telegram
TG_BOT_TOKEN=123456:ABC-DEF
TG_CHAT_ID=-1001234567890
TG_WARNING_CHAT_ID=-1001234567891
TG_PROXY=socks5://127.0.0.1:10800

# Поведение
ONLY_INCOMING=true
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BACKOFF_SEC=5
